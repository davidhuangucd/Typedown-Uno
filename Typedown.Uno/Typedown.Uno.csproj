<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Typedown.Uno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>uk.mingdan.typedown</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.1.4</ApplicationDisplayVersion>
    <ApplicationVersion>6</ApplicationVersion>
    <!-- Same number in the assembly, so the About box and the log can report it. CI adds the commit
         through SourceRevisionId, which .NET appends to the informational version. -->
    <Version>$(ApplicationDisplayVersion)</Version>
    <!-- The Uno SDK leaves these off in Debug, which makes the About box report 0.0.0 while developing. -->
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
    <!-- Package Publisher -->
    <ApplicationPublisher>Typedown.Uno</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Typedown.Uno powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
      WebView;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: the original Typedown logo instead of the template's placeholder. The sources live outside
         Assets/ because everything under Assets/Icons is also produced by Resizetizer (duplicate publish paths). -->
    <UnoIcon Remove="Assets/Icons/icon.svg" />
    <!-- The artwork already is the whole tile (a white card with the T). Putting it on a plate and shrinking
         it to 70% made the Windows build's icon a card inside a card, unlike the native edition's. -->
    <UnoIcon Include="Icons/icon.png" />
    <!-- A plain copy for the Linux desktop entry and the packages. -->
    <None Include="Icons/icon.png" Link="Assets/typedown.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The document that explains the theme format travels with the themes it describes. -->
    <None Include="../docs/custom-theme.md" Link="Assets/Themes/custom-theme.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../docs/privacy.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
